# ---------------------------------------------------------------------------
# Where to set these
#
#   Local dev : copy this file to `.env.local` (git-ignored) and fill it in.
#   Netlify   : Site configuration -> Environment variables -> Add a variable,
#               or "Import from a .env file" and paste this file's contents.
#               Add every key below for the Production scope, then redeploy.
#               CLI equivalent: netlify env:import .env.local
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# changing one needs a fresh deploy. The rest are read on the server only.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemaps and social images.
# On Netlify this is the real public site URL.
NEXT_PUBLIC_SITE_URL=https://your-site.com

# ---------------------------------------------------------------------------
# Supabase -- Supabase Dashboard -> Project Settings -> API Keys
#
# The publishable/anon key is NOT needed: every read and write happens on the
# server, so only the secret (service-role) key is used, and it must stay
# server-side. Never rename it with a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public Storage bucket that holds lead images (Storage -> New bucket, Public).
SUPABASE_STORAGE_BUCKET=covers

# Signs every editorial session cookie. Required in production: the app throws
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOGIN_SECRET=

# Shared secret for the once-a-day RSS refresh. Netlify runs
# netlify/functions/wire-daily.mjs on a schedule and calls /api/wire/cron with
# this value; without it the daily run is skipped and the wire only changes when
# an editor presses refresh in the desk. Any long random string works:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# One-time content migration only (node scripts/migrate-firestore.mjs).
# The site no longer reads Firebase at runtime -- remove these from Netlify
# once the stories have been copied into Supabase.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
